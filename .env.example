# Template only — put real values in .env.local, which is git-ignored.
# This file IS committed, so never write a real token here.

# Baserow — lead capture for the contact form.
# Create a database token in Baserow (Settings → Database tokens) with
# "create" permission on the leads table.
BASEROW_TOKEN=
BASEROW_TABLE_ID=

# Base URL of the Baserow instance. Required.
# Self-hosted, e.g. https://data.example.com — or https://api.baserow.io
BASEROW_API_URL=
